# ---------------------------------------------------------------------------
# CorroborIA — configuration de la couche LLM (copier en .env, tout est optionnel)
# Sans aucune variable, l'analyse IA locale (patterns + scikit-learn + gabarit)
# fonctionne entièrement hors ligne et gratuitement.
# ---------------------------------------------------------------------------

# Ordre de repli des fournisseurs (le premier disponible qui répond est utilisé)
LLM_PROVIDERS=claude,ollama,groq,gemini,openrouter,pollinations,template

# 1) Claude (Anthropic) — payant, prioritaire si la clé est présente
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5

# 2) Ollama — GRATUIT, 100 % local (aucune donnée ne quitte la machine)
#    Installation : https://ollama.com  puis  `ollama pull qwen2.5:7b`
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# 3) Groq — clé GRATUITE sans carte : https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# 4) Google Gemini — clé GRATUITE : https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash

# 5) OpenRouter — clé GRATUITE, modèles « :free » : https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 6) Pollinations — sans clé, service public best-effort (instable). Opt-in explicite.
# ALLOW_KEYLESS_PUBLIC_LLM=1

# Divers
# LLM_TIMEOUT=90          # secondes par appel
# LLM_CACHE=1             # cache disque des réponses (output/.llm_cache.json)
# ASSIGN_START_MODE=max   # interprétation de la règle assignmentStartDate (max | min), voir README
